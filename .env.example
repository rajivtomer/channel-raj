# Public URL of this app. OAuth redirect URIs are built from it.
APP_URL=http://localhost:3000

# Postgres connection string (for example a Neon database).
# Leave empty to use a local embedded database stored in .data/pglite.
DATABASE_URL=

# 32 random bytes, base64. Encrypts API secrets and channel tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required in production. In development a key is generated into .data/ if missing.
ENCRYPTION_KEY=

# Meta Graph API version used for Facebook and Instagram calls.
META_GRAPH_VERSION=v23.0
